{
  "name": "lingualive",
  "type": "commonjs",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time AI language tutor — monorepo root",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"cyan,magenta\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "eval:metrics": "node --require ts-node/register evaluation/scripts/calculate-metrics.ts",
    "eval:test": "node --require ts-node/register evaluation/scripts/calculate-metrics.ts --test",
    "test:audio-worklet": "node --require ts-node/register scripts/test-audio-worklet.ts",
    "test:stt-dedup": "node --experimental-strip-types scripts/test-stt-deduplication.mts",
    "install:all": "npm install"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
