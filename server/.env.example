# Server environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# Origin allowed by CORS (frontend dev server)
CORS_ORIGIN=http://localhost:5173

# ── AssemblyAI ────────────────────────────────────────────────────────────────
# Obtain your key at https://www.assemblyai.com
ASSEMBLYAI_API_KEY=

# ── AssemblyAI LLM Gateway (Phase 3) ──────────────────────────────────────────
# Default model for the language tutor
ASSEMBLYAI_LLM_MODEL=gpt-4.1

